# Odoo Configuration
ODOO_URL=https://your-instance.odoo.com
ODOO_DATABASE=your-database-name
ODOO_RPC_KEY=your-odoo-api-key-here

# Test Odoo Instance (for E2E tests with real API calls)
TEST_ODOO_URL=https://test-instance.odoo.com
TEST_ODOO_DATABASE=test-database-name
TEST_ODOO_RPC_KEY=your-test-odoo-api-key-here


# Configure the actual, non-terminal "Awaiting Confirmation" stage ID in your Odoo database.
# 0 disables stage updates safely until the administrator confirms the mapping.
ODOO_STAGE_AWAITING_CONFIRMATION=0
# Optional comma-separated IDs of terminal/Done stages; must NOT contain the awaiting stage.
ODOO_STAGE_DONE_IDS=

# Default POC identity verification fails closed without a trusted verifier.
# Use a mocked VERIFIED verifier in isolated offline tests only.
IDENTITY_VERIFICATION_MODE=mock_training_poc

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com

# Logging & Monitoring
LOG_LEVEL=INFO
ENVIRONMENT=development

# Timeouts and Retries
REQUEST_TIMEOUT=30
MAX_RETRIES=3
HR_CACHE_TTL=300
